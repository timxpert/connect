# Supabase → Project Settings → API Keys (add these in Vercel as Config)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Student ID sign-in (server only). Add in Vercel as a Secret, never with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: where "Motion Dojo website" in the account menu points
NEXT_PUBLIC_MAIN_SITE_URL=https://joinmotiondojo.com

# Cloudflare R2 for videos and chat files (optional; without it they go to Supabase)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
# Secret: never NEXT_PUBLIC_
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=md-media
R2_PRIVATE_BUCKET=md-chat
# The public bucket's address, e.g. https://pub-xxxxxxxx.r2.dev
NEXT_PUBLIC_R2_PUBLIC_URL=
